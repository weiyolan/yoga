# Next.js frontend. Copy to .env.local. Sanity values from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=1pbhk0to
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Webhook secret (Sanity → API → Webhooks → Secret) for /api/revalidate
SANITY_REVALIDATE_SECRET=

# Live preview (Studio → Live preview): Viewer token from sanity.io/manage → API → Tokens.
# Server-only. Without it the Presentation tool shows published content only.
SANITY_API_READ_TOKEN=

# Retreat sign-up form: stores each sign-up in Sanity (Studio → Inschrijvingen).
# Editor token from sanity.io/manage → API → Tokens. Server-only: never prefix with NEXT_PUBLIC.
# Without it, sign-ups are only logged (local dev).
SANITY_WRITE_TOKEN=

# Contact + newsletter mail via Resend (without a key, mails are logged)
RESEND_API_KEY=
CONTACT_FROM="Yoga, Zen & Tonic <website@yogazentonic.com>"
# CONTACT_TO=   (default: e-mail in Sanity → Instellingen)
