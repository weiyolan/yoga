# Next.js frontend. Copy to .env.local. Sanity values from https://www.sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=1pbhk0to
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Webhook secret (Sanity → API → Webhooks → Secret) for /api/revalidate
SANITY_REVALIDATE_SECRET=

# Contact + newsletter mail via Resend (without a key, mails are logged)
RESEND_API_KEY=
CONTACT_FROM="Yoga, Zen & Tonic <website@yogazentonic.be>"
# CONTACT_TO=   (default: e-mail in Sanity → Instellingen)
